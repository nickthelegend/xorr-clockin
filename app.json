{
  "expo": {
    "name": "xorr",
    "slug": "xorr",
    "scheme": "xorr",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "finance.xorr.app",
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSFaceIDUsageDescription": "xorr uses Face ID to authorise payouts and changes to what your bot is allowed to do.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "finance.xorr.app",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 4,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "./plugins/with-spaces-in-project-path",
      "./plugins/with-release-signing",
      [
        "./plugins/with-android-notification-icon",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#12D77D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
